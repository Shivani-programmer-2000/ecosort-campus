# Copy this file to .streamlit/secrets.toml for local runs (it is git-ignored).
# On Streamlit Community Cloud, paste the same lines into: Advanced settings -> Secrets.

# Shown in the page footer
AUTHOR = "NADELLA SHIVANI, JAIN UNIVERSITY"

# "offline" needs no keys. Switch to "watsonx" only when you have real IBM Cloud keys.
LLM_PROVIDER = "offline"
WATSONX_URL = "https://us-south.ml.cloud.ibm.com"
WATSONX_API_KEY = "paste-your-IBM-Cloud-API-key"
WATSONX_PROJECT_ID = "paste-your-watsonx-project-id"
WATSONX_MODEL_ID = "ibm/granite-4-h-small"

# Protects your free token quota on a public app (0 = unlimited)
LLM_DAILY_CAP = "25"
